# Copy to .env and fill in real values there. Never commit .env.

# Bot token from BotFather.
TELEGRAM_BOT_TOKEN=

# polling or webhook. Polling is the simple mode for one host.
TELEGRAM_TRANSPORT=polling

# Required for webhook transport and for npm run telegram:set-webhook.
# 32–256 characters from A–Z, a–z, 0–9, underscore and hyphen.
TELEGRAM_WEBHOOK_SECRET=

# Public https origin with no path. Required by npm run telegram:set-webhook.
PUBLIC_URL=

# Comma-separated numeric Telegram user IDs. Required when NODE_ENV=production.
# When unset outside production, the bot starts and accepts every user.
TELEGRAM_ALLOWED_USER_IDS=

# Postgres connection string. Compose overrides this for the bot service.
DATABASE_URL=postgresql://relay:relay@127.0.0.1:5432/relay

# When set, a confirmed run calls the OpenAI Responses API.
# When unset, the run stays a scripted demo. Tests never use a real key.
OPENAI_API_KEY=

# Optional. Defaults to gpt-6-luna, a current small model.
OPENAI_MODEL=gpt-6-luna

# Webhook listen address. Polling does not open this port.
PORT=3000
HOST=127.0.0.1

# production refuses to start without TELEGRAM_ALLOWED_USER_IDS.
NODE_ENV=development
